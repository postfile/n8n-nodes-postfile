{
  "name": "n8n-nodes-postfile",
  "version": "0.0.8",
  "description": "n8n community node for PostFile. Upload files and get public URLs instantly.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "file upload",
    "file hosting",
    "public url",
    "cdn"
  ],
  "license": "MIT",
  "homepage": "https://postfile.net",
  "author": {
    "name": "PostFile",
    "email": "support@postfile.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postfile/n8n-nodes-postfile.git"
  },
  "main": "index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PostFileApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PostFile/PostFile.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes/PostFile dist/credentials && cp nodes/PostFile/*.svg dist/nodes/PostFile/ && cp credentials/*.svg dist/credentials/",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.28.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "n8n-workflow": "^2.13.1",
    "typescript": "~5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
